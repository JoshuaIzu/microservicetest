# Auth + Payments
DATABASE_URL="postgresql://api_user:your_password@127.0.0.1:5432/fintech_api?schema=fintech"
JWT_SECRET="replace-with-a-random-secret"
MOCK_WEBHOOK_SECRET="replace-with-a-different-random-secret"
PORT=3000

# Shared broker
AMQP_URL="amqp://fintech_user:your_password@127.0.0.1:5672/fintech"

# Ledger only
LEDGER_DATABASE_URL="postgresql://ledger_user:your_password@127.0.0.1:5432/fintech_ledger?schema=fintech"

# Reconciliation only
RECONCILIATION_DATABASE_URL="postgresql://reconciliation_user:your_password@127.0.0.1:5432/fintech_reconciliation?schema=fintech"
AUTH_BASE_URL="http://127.0.0.1:3000"
RECONCILIATION_PORT=3001
