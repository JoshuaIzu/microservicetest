generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@demo/ledger-db"
}

datasource db {
  provider = "postgresql"
  url      = env("LEDGER_DATABASE_URL")
  schemas  = ["fintech"]
}

model Journal {
  paymentId String  @id @db.Uuid
  eventId   String  @unique @db.Uuid
  currency  String
  entries   Entry[]

  @@schema("fintech")
}

model Entry {
  id          String  @id @default(uuid()) @db.Uuid
  paymentId   String  @db.Uuid
  journal     Journal @relation(fields: [paymentId], references: [paymentId])
  account     String
  side        String
  amountMinor Int

  @@index([paymentId])
  @@schema("fintech")
}
